{
  "name": "zario",
  "version": "0.9.0",
  "description": "Tiny zero-dependency structured logger for Bun, Node.js and TypeScript. Redaction, JWE log encryption, and syslog over UDP, TCP and TLS.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./full": {
      "types": "./dist/full.d.ts",
      "import": "./dist/full.js",
      "require": "./dist/full.cjs"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "import": "./dist/logger.js",
      "require": "./dist/logger.cjs"
    },
    "./encryption": {
      "types": "./dist/encryption.d.ts",
      "import": "./dist/encryption.js",
      "require": "./dist/encryption.cjs"
    },
    "./queue": {
      "types": "./dist/queue.d.ts",
      "import": "./dist/queue.js",
      "require": "./dist/queue.cjs"
    },
    "./integrity": {
      "types": "./dist/integrity.d.ts",
      "import": "./dist/integrity.js",
      "require": "./dist/integrity.cjs"
    },
    "./transports": {
      "types": "./dist/transports/index.d.ts",
      "import": "./dist/transports/index.js",
      "require": "./dist/transports/index.cjs"
    },
    "./filters": {
      "types": "./dist/filters/index.d.ts",
      "import": "./dist/filters/index.js",
      "require": "./dist/filters/index.cjs"
    },
    "./aggregation": {
      "types": "./dist/aggregation/index.d.ts",
      "import": "./dist/aggregation/index.js",
      "require": "./dist/aggregation/index.cjs"
    },
    "./structured": {
      "types": "./dist/structured/index.d.ts",
      "import": "./dist/structured/index.js",
      "require": "./dist/structured/index.cjs"
    },
    "./context": {
      "types": "./dist/context/index.d.ts",
      "import": "./dist/context/index.js",
      "require": "./dist/context/index.cjs"
    },
    "./otel": {
      "types": "./dist/otel/index.d.ts",
      "import": "./dist/otel/index.js",
      "require": "./dist/otel/index.cjs"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "import": "./dist/core/*.js",
      "require": "./dist/core/*.cjs"
    },
    "./transports/*": {
      "types": "./dist/transports/*.d.ts",
      "import": "./dist/transports/*.js",
      "require": "./dist/transports/*.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "bun test",
    "lint": "eslint src benchmarks --ext .ts --max-warnings=0",
    "bench": "bun benchmarks/run.ts --suite hot",
    "bench:compare": "bun benchmarks/run.ts --suite compare",
    "bench:adversarial": "bun benchmarks/run.ts --suite adversarial",
    "bench:all": "bun benchmarks/run.ts --suite all",
    "check-benchmark-schema": "bun scripts/check-benchmark-schema.js",
    "check-bundle-size": "bun run scripts/check-bundle-size.js",
    "prepublishOnly": "bun run build",
    "check-package-schema": "bun scripts/validate-package-json.cjs",
    "test:compat": "jest --runInBand",
    "typecheck": "tsc --noEmit && tsc -p tests/types/tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Dev-Dami/zario.git"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/Dev-Dami"
  },
  "keywords": [
    "logger",
    "logging",
    "structured-logging",
    "json-logger",
    "typescript",
    "nodejs",
    "bun",
    "bun-logger",
    "elysia",
    "pino-alternative",
    "winston-alternative",
    "redaction",
    "pii",
    "log-encryption",
    "zero-dependencies",
    "lightweight",
    "observability",
    "transports",
    "syslog",
    "rfc5424",
    "jwe",
    "tamper-evident",
    "audit-log"
  ],
  "author": "Dev-dami",
  "license": "MIT",
  "sideEffects": [
    "./dist/full.js",
    "./dist/full.cjs"
  ],
  "type": "module",
  "bugs": {
    "url": "https://github.com/Dev-Dami/zario/issues"
  },
  "homepage": "https://github.com/Dev-Dami/zario#readme",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "@types/bun": "^1.4.2"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "llms.txt",
    "skills/**/*"
  ],
  "packageManager": "bun@1.4.0",
  "engines": {
    "bun": ">=1.3.2",
    "node": ">=20"
  }
}
